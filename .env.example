# Skopiuj do .env i uzupełnij sekrety (scripts/start-local.ps1 robi to automatycznie z losowymi wartościami).
# Plik .env jest w .gitignore – nie commituj go.

# --- sekrety -----------------------------------------------------------------
IW_INTERNAL_TOKEN=change-me-long-random-string
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=scopeonmedia
S3_SECRET_KEY=change-me-long-random-string

# --- silnik AI (on-premise, Ollama) --------------------------------------------
IW_LLM_ENGINE=ollama
# gemma4:e2b ≈ 4,3 GB (CPU, 16 GB RAM); gemma4:e4b ≈ 6,3 GB (lepsza jakość, zalecany GPU)
IW_LLM_MODEL=gemma4:e2b
# oba modele na licencji Apache 2.0
IW_EMBED_MODEL=qwen3-embedding:0.6b
IW_LLM_WEIGHT=0.35

# --- scraping ------------------------------------------------------------------
IW_RENDER_MODE=auto
IW_PROXIES=
IW_CRAWL_DELAY_S=0.5
IW_REGISTRY_SOURCES=demo

# --- opcjonalne tokeny bezpłatnych API platform (puste = mock demonstracyjny) -----
IW_META_AD_LIBRARY_TOKEN=
IW_TIKTOK_RESEARCH_TOKEN=
IW_INSTAGRAM_GRAPH_TOKEN=
